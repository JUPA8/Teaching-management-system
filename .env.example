# ============================================================
# .env.example — Salam Institute
# ============================================================
# HOW TO USE:
#   Local dev  → copy this file to .env.local and fill in real values
#   Production → set all values in the Vercel dashboard (do NOT commit secrets)
#
# FILES THAT SHOULD NEVER BE COMMITTED:
#   .env, .env.local, .env.production, .env.development, .env.staging
#
# FILE LOADING ORDER (Next.js):
#   .env.local   > .env.development/.env.production > .env
#   Always create .env.local for local dev — it overrides everything.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon pooled URL (for the app):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional: Neon direct (non-pooled) URL for migrations only.
# Only needed if you add `directUrl = env("DIRECT_URL")` to prisma/schema.prisma.
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"           # change to your domain in production
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"    # change to your domain in production
NEXT_PUBLIC_APP_ENV="development"              # "production" on Vercel

# ── SMTP Email (required for verification, password reset, contact form) ──────
# Recommended: Resend (resend.com) — free tier: 3,000 emails/month
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx  (your Resend API key)
#   SMTP_FROM=noreply@salam-institut.com
#
# Alternative: Gmail App Password
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.gmail@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx  (16-char Google App Password)
#   SMTP_FROM=noreply@salam-institut.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@salam-institut.com"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# ── AWS S3 (for file uploads) ─────────────────────────────────────────────────
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="salam-institute-uploads"

# ── Upstash Redis (for rate limiting) ─────────────────────────────────────────
# UPSTASH_REDIS_REST_URL="https://your-upstash-url"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
